#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/* Key positions (see assets/key-positions.md), used for positional hold-tap. */
#define KEYS_L  0  1  2  3  4  5  6 \
               14 15 16 17 18 19 20 \
               28 29 30 31 32 33 34 \
               46 47 48 49 50 51    \
               60 61 62 63 64

#define KEYS_R  7  8  9 10 11 12 13 \
               21 22 23 24 25 26 27 \
               39 40 41 42 43 44 45 \
                  54 55 56 57 58 59 \
                     71 72 73 74 75

#define THUMBS 35 36 52 65 66 67 \
               37 38 53 68 69 70

/*
 * Global defaults for ZMK's built-in layer-tap (&lt) and mod-tap (&mt)
 * behaviors, copied from the TOTEM keyboard config.
 */
&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <140>;
};

// Trigger tap-action on all interrupts.
&mt {
  flavor = "tap-preferred";
  tapping-term-ms = <220>;
  quick-tap-ms = <220>;
  hold-trigger-key-positions = <0>;
};

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      /*
       * Timeless homerow mods, following urob's zmk-config:
       * https://github.com/urob/zmk-config#timeless-homerow-mods
       *
       * - "balanced" flavor: a hold is produced as soon as another key is
       *   pressed and released within the tapping term;
       * - require-prior-idle-ms: pressing an HRM shortly after another key
       *   resolves it as a tap right away, so normal typing is not delayed;
       * - hold-trigger-key-positions: an HRM only becomes a modifier when the
       *   next key is on the other hand (or a thumb key);
       * - hold-trigger-on-release: the positional check happens on release so
       *   several modifiers on the same hand can be combined.
       */
      hml: homerow_mods_left {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <KEYS_R THUMBS>;
          hold-trigger-on-release;
      };

      hmr: homerow_mods_right {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <KEYS_L THUMBS>;
          hold-trigger-on-release;
      };
    };

  /*
   * Combos, following the TOTEM config: short timeout so they only fire when
   * both keys go down together, and require-prior-idle-ms so rolling "jk" or
   * "kl" while typing does not trigger them. Key positions: J=41 K=42 L=43.
   */
  combos {
    compatible = "zmk,combos";

    // J + K -> Cmd+Shift+[ (previous tab on macOS)
    combo_prev_tab {
      timeout-ms = <18>;
      require-prior-idle-ms = <150>;
      key-positions = <41 42>;
      bindings = <&kp LG(LS(LBKT))>;
      layers = <0>;
    };

    // K + L -> Cmd+Shift+] (next tab on macOS)
    combo_next_tab {
      timeout-ms = <18>;
      require-prior-idle-ms = <150>;
      key-positions = <42 43>;
      bindings = <&kp LG(LS(RBKT))>;
      layers = <0>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1      &kp N2      &kp N3       &kp N4       &kp N5 &caps_word                                                             &mo 3 &kp N6 &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
        &kp TAB   &kp Q       &kp W       &kp E        &kp R        &kp T  &kp LG(SPACE)                                                              &none &kp Y  &kp U        &kp I        &kp O       &kp P          &kp BSLH
        &kp ESC   &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G  &kp LG(LA(LS(S)))           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL             &kp RGUI &kp H  &hmr LCTRL J &hmr RSHFT K &hmr LALT L &hmr LGUI SEMI &kp SQT
        &kp LSHFT &kp Z       &kp X       &kp C        &kp V        &kp B                            &kp HOME &kp PG_UP                             &kp N  &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
        &mo 2     &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                  &lt 1 SPACE &kp DEL &kp END &kp PG_DN &kp ENTER &kp BSPC                 &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1      &kp N2      &kp N3       &kp N4       &kp N5 &tog 1                                                             &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q       &kp W       &kp E        &kp R        &kp T  &none                                                              &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL             &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z       &kp X       &kp C        &kp V        &kp B                            &kp HOME &kp PG_UP                             &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                  &trans   &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp LA(BSPC)             &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans      &none      &none      &none &none &none &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                               &bootloader &none      &none      &none &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &none       &none      &none      &none &none &none &none
        &none          &none        &none        &none        &macro_ver   &none                                      &none &none                                             &none      &none      &none &none &none &none
        &none          &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                   &bl BL_INC &bl BL_DEC &none &none &none
      >;
    };
    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
